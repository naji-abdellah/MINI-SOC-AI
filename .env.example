# MiniSOC-AI Environment Configuration Example
# Copy to .env: cp .env.example .env

# Storage
DUCKDB_PATH=data/minisoc.duckdb

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text

# Guardrails & Audit
AUDIT_LOG_PATH=data/audit_log.jsonl
ACTION_ALLOWLIST=block_ip,isolate_host,create_ticket,notify_analyst,dismiss_alert

# Log Level
LOG_LEVEL=INFO
