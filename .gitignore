# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Databases & Vector Stores (Local storage - keep out of git)
*.duckdb
*.duckdb.wal
*.sqlite
*.sqlite3
*.db
chroma_db/
faiss_index/

# Data directories (keep directory structure via .gitkeep, ignore actual bulk data)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# data/samples is allowed for small mock fixtures (< 1 MB)

# Logs & Captures
logs/
*.log
*.pcap
*.evtx
*.zst

# Environment variables & secrets
.env
.env.*
!.env.example

# LLM & Eval temporary artifacts
evals/output/
.promptfoo/
promptfoo_cache/

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
